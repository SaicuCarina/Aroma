@model proj.Models.AdvertisementModel

@{
    ViewData["Title"] = "Add Advertisement";
}

<div class="background-container"></div>

<div class="d-flex justify-content-center align-items-start min-vh-75 pt-4">
    <div class="form-container p-4 bg-white shadow rounded">
        <h1 class="text-center mb-3">Add Advertisement</h1>
        <hr />

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label">Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Photo" class="form-label">Photo</label>
                <input asp-for="Photo" type="file" class="form-control" />
                <span asp-validation-for="Photo" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Link" class="form-label">Link</label>
                <input asp-for="Link" class="form-control" />
                <span asp-validation-for="Link" class="text-danger"></span>
            </div>

            <div class="text-center">
                <input type="submit" value="Add" class="btn btn-primary w-100" />
            </div>
        </form>
    </div>
</div>

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}

<style>
    /* Fundal */
    .background-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('/imag/wallpaperv1.jpg');
        background-size: cover;
        background-position: center;
        z-index: -1;
    }

    /* Stil pentru formular */
    .form-container {
        width: 100%;
        max-width: 500px;
        border: 1px solid #ddd;
    }
</style>
