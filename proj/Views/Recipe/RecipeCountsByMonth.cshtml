@{
    var recipeCounts = ViewBag.RecipeCounts as int[];
    var contestCounts = ViewBag.ContestCounts as int[] ?? new int[12]; // Default to an array of 12 zeros if null
    string[] monthNames = new string[]
    {
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
    };
    int maxRecipeCount = recipeCounts?.Max() ?? 0; // Max value for recipe counts
    int maxContestCount = contestCounts.Max(); // Max value for contest recipe counts
    var usersCount = ViewBag.UsersCount as int[] ?? new int[12]; // Vector dinamic

    int maxUsersCount = usersCount.Max();

}

<style>
    /* Stilul pentru div-ul de fundal */
    .background-container {
        position: fixed; /* Poziționează imaginea relativ la fereastra browser-ului */
        top: 0;
        left: 0;
        width: 100%; /* Întinde div-ul pe toată lățimea paginii */
        height: 100%; /* Întinde div-ul pe toată înălțimea paginii */
        background-image: url('/imag/wallpaperv1.jpg'); /* Calea către imaginea ta */
        background-size: cover; /* Face ca imaginea să ocupe întreaga zonă */
        background-position: center; /* Centrează imaginea */
        z-index: -1; /* Pune div-ul în spatele altor elemente */
    }

    /* Conținutul paginii tale */
    .content {
        position: relative; /* Asigură-te că elementele conținutului sunt deasupra div-ului de fundal */
        z-index: 1; /* Păstrează conținutul deasupra imaginii */
        color: white; /* Opțional: Schimbă culoarea textului pentru a fi vizibil pe fundal */
        padding: 20px;
    }

    .chart-container {
        display: flex;
        justify-content: space-around;
        align-items: flex-end;
        height: 300px;
        width: 80%;
        margin: 20px auto;
        border-left: 2px solid #333;
        border-bottom: 2px solid #333;
        position: relative;
    }

    .bar {
        width: 30px;
        margin: 0 5px;
        background-color: #4CAF50;
        text-align: center;
        color: white;
        font-size: 12px;
        display: flex;
        justify-content: center;
        align-items: flex-end;
    }

    .contest-bar {
        background-color: #2196F3; /* Different color for contest bars */
    }

    .user-bar {
        background-color: indianred; /* Different color for contest bars */
    }

    .bar-label {
        margin-top: 5px;
        font-size: 14px;
        text-align: center;
    }

    .chart-title {
        text-align: center;
        font-size: 20px;
        margin-bottom: 10px;
    }

    .no-data {
        text-align: center;
        font-size: 18px;
        color: #999;
    }
</style>
<div class="background-container"></div>

<div style="background-color: white;padding: 10px;
        border: 1px solid #ddd;">

@if (recipeCounts != null)
{
    <!-- Recipe Counts Chart -->
    <div>
        <h2 class="chart-title">Recipe Counts by Month</h2>
        <div class="chart-container">
            @for (int i = 0; i < recipeCounts.Length; i++)
            {
                var barHeight = (recipeCounts[i] / (double)maxRecipeCount) * 100; // Scale the bar height based on the max value
                <div class="bar" style="height: @barHeight%;">
                    <span>@recipeCounts[i]</span>
                </div>
            }
        </div>
        <div class="bar-labels">
            <div style="display: flex; justify-content: space-around; width: 80%; margin: 0 auto;">
                @for (int i = 0; i < monthNames.Length; i++)
                {
                    <div class="bar-label">@monthNames[i].Substring(0, 3)</div> <!-- Shortened month names -->
                }
            </div>
        </div>
    </div>

    <!-- Contest Recipe Counts Chart -->
    <div>
        <h2 class="chart-title">Contest Recipe Counts by Month</h2>
        <div class="chart-container">
            @for (int i = 0; i < contestCounts.Length; i++)
            {
                var barHeight = (contestCounts[i] / (double)maxContestCount) * 100; // Scale the bar height based on the max value
                <div class="bar contest-bar" style="height: @barHeight%;">
                    <span>@contestCounts[i]</span>
                </div>
            }
        </div>
        <div class="bar-labels">
            <div style="display: flex; justify-content: space-around; width: 80%; margin: 0 auto;">
                @for (int i = 0; i < monthNames.Length; i++)
                {
                    <div class="bar-label">@monthNames[i].Substring(0, 3)</div> <!-- Shortened month names -->
                }
            </div>
        </div>
    </div>

        <div>
            <h2 class="chart-title">New Users Each Month</h2>
            <div class="chart-container">
                @for (int i = 0; i < usersCount.Length; i++)
                {
                    var barHeight = (usersCount[i] / (double)maxUsersCount) * 100;
                    <div class="bar user-bar" style="height: @barHeight%;">
                        <span>@usersCount[i]</span>
                    </div>
                }
            </div>
            <div class="bar-labels">
                <div style="display: flex; justify-content: space-around; width: 80%; margin: 0 auto;">
                    @for (int i = 0; i < monthNames.Length; i++)
                    {
                        <div class="bar-label">@monthNames[i].Substring(0, 3)</div>
                    }
                </div>
            </div>
        </div>
}
else
{
    <p class="no-data">No data available.</p>
}

</div>