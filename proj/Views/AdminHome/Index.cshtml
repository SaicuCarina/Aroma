@{
    // Declare recipeCounts and monthNames at the top of the view
    var recipeCounts = ViewBag.RecipeCounts as int[]; // Fetch data from ViewBag
    string[] monthNames = new string[]
    {
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
    };
}

@if (recipeCounts != null) // Check if recipeCounts is not null
{
    <div>
        <h2>Recipe Counts by Month</h2>
        <table border="1">
            <thead>
                <tr>
                    <th>Month</th>
                    <th>Number of Recipes</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < recipeCounts.Length; i++) // Iterate through the array
                {
                    <tr>
                        <td>@monthNames[i]</td> <!-- Month name -->
                        <td>@recipeCounts[i]</td> <!-- Recipe count -->
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p>No data available.</p> <!-- Message if no data exists -->
}
