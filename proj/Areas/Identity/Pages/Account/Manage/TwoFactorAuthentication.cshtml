@page
@model proj.Areas.Identity.Pages.Account.Manage.FavouriteRecipesModel
@{
    ViewData["Title"] = "Your Favourite Recipes";
}
<div class="background-container"></div>

<h2>Your Favourite Recipes</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (!Model.FavouriteRecipes.Any())
{
    <p>You have no favourite recipes yet.</p>
}
else
{
    <div class="recipe-list">
        @foreach (var recipe in Model.FavouriteRecipes)
        {
            <li style="display: flex; align-items: center; margin-bottom: 20px;">
                @if (!string.IsNullOrEmpty(recipe.PhotoPath))
                {
                    <div style="flex-shrink: 0; margin-right: 20px;">
                        <img src="~/imag/@recipe.PhotoPath" alt="Recipe Image" class="recipe-photo" style="width: 200px; height: 200px; object-fit: cover;" />
                    </div>
                }

                <div>
                    <strong>@recipe.Title</strong>
                    <p>Posted on: @recipe.Date.ToString("dd MMM yyyy")</p>
                    <br />
                    <a href="@Url.Action("Details", "Recipe", new { id = recipe.Id })" class="btn btn-secondary">See content</a>
                </div>
            </li>
        }
    </div>
}

<style>
    /* Fundal */
    .background-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('/imag/wallpaperv1.jpg');
        background-size: cover;
        background-position: center;
        z-index: -1;
    }

    /* Centrare și stil pentru formular */
    .form-container {
        width: 100%;
        max-width: 500px;
        border: 1px solid #ddd;
    }
</style>
